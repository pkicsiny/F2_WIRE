  <property name="styleSheet">
   <string notr="true">/* FACET-II control-room palette
   Graphite structure, beam-magenta primary actions, cyan focus/status */
QWidget#Form {
    background-color: #0B0D12;
    color: #E8ECF3;
    font-family: &quot;Segoe UI&quot;, &quot;Helvetica Neue&quot;, Arial, sans-serif;
    font-size: 10pt;
}

QFrame {
    background-color: #141820;
    border: 1px solid #2B3240;
    border-radius: 7px;
}

QFrame#frame_2 {
    background-color: #10131A;
    border: 1px solid #3A2134;
    border-bottom: 3px solid #D81B60;
    border-radius: 8px;
}

QLabel {
    background: transparent;
    border: none;
    color: #C9D0DC;
}

QLabel#label_2 {
    color: #F7F9FC;
    font-size: 20pt;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#label_11, QLabel#label_12 {
    color: #53D8E6;
    font-size: 15pt;
    font-weight: 700;
}

QTabWidget::pane {
    background-color: #10131A;
    border: 1px solid #2B3240;
    border-radius: 7px;
    top: -1px;
}

QTabBar::tab {
    background-color: #171C25;
    color: #9DA7B7;
    border: 1px solid #2B3240;
    border-bottom: none;
    padding: 9px 20px;
    margin-right: 3px;
    min-width: 110px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #24202B;
    color: #FFFFFF;
    border-top: 3px solid #D81B60;
}

QTabBar::tab:hover:!selected {
    background-color: #202632;
    color: #E8ECF3;
}

QPushButton {
    background-color: #242B37;
    color: #F3F5F8;
    border: 1px solid #3A4556;
    border-radius: 5px;
    padding: 7px 13px;
    min-height: 20px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #303948;
    border-color: #53D8E6;
}

QPushButton:pressed {
    background-color: #161B23;
    padding-top: 8px;
    padding-bottom: 6px;
}

QPushButton:focus {
    border: 2px solid #53D8E6;
}

QPushButton:disabled {
    background-color: #191D25;
    color: #626B79;
    border-color: #252B35;
}

